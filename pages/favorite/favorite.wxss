/* pages/favorite/favorite.wxss */
.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}

/* 顶部操作栏 */
.action-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #fff;
  padding: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #eee;
}

.action-bar .left {
  font-size: 28rpx;
  color: #666;
}

.action-bar .right {
  display: flex;
  gap: 20rpx;
}

.action-bar .right text {
  font-size: 28rpx;
  color: #1296db;
}

.action-bar .right .cancel {
  color: #999;
}

.action-bar .right .compare.disabled {
  color: #999;
  opacity: 0.5;
}

/* 商品列表 */
.products-container {
  margin-top: 88rpx;
  flex: 1;
  padding: 20rpx;
}

.products-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.product-card {
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
  position: relative;
}

/* 选择框 */
.select-box {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  z-index: 1;
  width: 40rpx;
  height: 40rpx;
  background: rgba(255,255,255,0.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkbox {
  width: 28rpx;
  height: 28rpx;
  border: 2rpx solid #ddd;
  border-radius: 50%;
}

.checkbox.checked {
  background: #1296db;
  border-color: #1296db;
  position: relative;
}

.checkbox.checked::after {
  content: '';
  position: absolute;
  left: 8rpx;
  top: 4rpx;
  width: 8rpx;
  height: 14rpx;
  border: solid white;
  border-width: 0 2rpx 2rpx 0;
  transform: rotate(45deg);
}

.product-image {
  width: 100%;
  height: 300rpx;
}

.product-info {
  padding: 16rpx;
}

.product-name {
  font-size: 28rpx;
  color: #333;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.product-price {
  color: #ff4444;
  font-size: 32rpx;
  font-weight: bold;
  margin-top: 10rpx;
}

.product-specs {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}

.spec-item {
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.product-rating {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.product-actions {
  position: absolute;
  right: 10rpx;
  bottom: 10rpx;
  display: flex;
  gap: 10rpx;
}

.action-btn {
  width: 48rpx;
  height: 48rpx;
  padding: 6rpx;
}

.action-btn image {
  width: 100%;
  height: 100%;
}

/* 对比弹窗 */
.compare-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
}

.modal-content {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 20rpx 20rpx 0 0;
  height: 90vh;
  display: flex;
  flex-direction: column;
}

.modal-header {
  padding: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #eee;
}

.modal-header text {
  font-size: 32rpx;
  font-weight: bold;
}

.modal-header .close {
  font-size: 40rpx;
  color: #999;
  padding: 10rpx;
}

.compare-content {
  flex: 1;
  overflow-y: auto;
}

/* 商品预览 */
.products-preview {
  display: flex;
  padding: 20rpx;
  gap: 20rpx;
  border-bottom: 1rpx solid #eee;
}

.product-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.product-item image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 8rpx;
}

.product-item .name {
  font-size: 24rpx;
  color: #333;
  text-align: center;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.product-item .price {
  font-size: 28rpx;
  color: #ff4444;
  font-weight: bold;
}

/* 对比详情 */
.compare-details {
  padding: 20rpx;
}

.compare-item {
  margin-bottom: 20rpx;
}

.compare-item .label {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.compare-item .values {
  display: flex;
  gap: 20rpx;
}

.compare-item .values text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  text-align: center;
}

.compare-item .values text.highlight {
  color: #1296db;
  font-weight: bold;
}

/* 底部操作栏 */
.modal-footer {
  padding: 20rpx;
  border-top: 1rpx solid #eee;
  display: flex;
  gap: 20rpx;
}

.btn-buy {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: #1296db;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
}

/* 空状态 */
.empty-tip {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.empty-tip image {
  width: 120rpx;
  height: 120rpx;
  opacity: 0.5;
}

.empty-tip text {
  font-size: 28rpx;
  color: #999;
}