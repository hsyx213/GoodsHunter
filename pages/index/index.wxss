/**index.wxss**/
.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 筛选栏样式 */
.filter-section {
  position: fixed;
  top: 0;
  width: 100%;
  background: #fff;
  z-index: 100;
  border-bottom: 1rpx solid #eee;
}

.filter-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
}

.filter-options {
  display: flex;
  align-items: center;
}

.filter-tab {
  position: relative;
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 28rpx;
  color: #666;
  padding: 10rpx 20rpx;
}

.selected-filters {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-left: 10rpx;
}

.selected-filter {
  background: #f0f0f0;
  border-radius: 20rpx;
  padding: 5rpx 10rpx;
  font-size: 24rpx;
  color: #333;
}

.selected-filter .remove {
  margin-left: 5rpx;
  color: #ff4444;
  cursor: pointer;
}

.sort-dropdown {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 28rpx;
  color: #666;
}

.arrow {
  display: inline-block;
  width: 0;
  height: 0;
  border-left: 6rpx solid transparent;
  border-right: 6rpx solid transparent;
  border-top: 8rpx solid #666;
  transition: transform 0.3s;
}

.arrow.up {
  transform: rotate(180deg);
}

/* 筛选弹出层样式 */
.filter-popup {
  position: fixed;
  top: 88rpx;
  left: 0;
  right: 0;
  background: #fff;
  z-index: 99;
  padding: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.option {
  padding: 10rpx 20rpx;
  border: 1rpx solid #ddd;
  border-radius: 30rpx;
  font-size: 26rpx;
}

.option.selected {
  background: #1296db;
  color: #fff;
  border-color: #1296db;
}

/* 商品列表样式 */
.products-container {
  margin-top: 180rpx;
  flex: 1;
  padding: 20rpx;
}

.products-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.product-card {
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
  position: relative;
}

.product-image {
  width: 100%;
  height: 300rpx;
}

.product-info {
  padding: 16rpx;
}

.product-name {
  font-size: 28rpx;
  color: #333;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.product-specs {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}

.spec-item {
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.product-price {
  color: #ff4444;
  font-size: 32rpx;
  font-weight: bold;
  margin-top: 10rpx;
}

.product-rating {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.product-actions {
  position: absolute;
  right: 10rpx;
  bottom: 10rpx;
  display: flex;
  gap: 10rpx;
}

.action-btn {
  width: 48rpx;
  height: 48rpx;
  padding: 6rpx;
}

.action-btn image {
  width: 100%;
  height: 100%;
}

/* 加载提示样式 */
.loading, .no-more {
  text-align: center;
  padding: 20rpx;
  color: #999;
  font-size: 26rpx;
}

/* 筛选下拉面板 */
.filter-dropdown {
  position: fixed;
  top: 88rpx;
  left: 0;
  right: 0;
  background: #fff;
  z-index: 99;
  padding: 30rpx 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
  max-height: 80vh;
  overflow-y: auto;
}

.filter-section-title {
  font-size: 24rpx;
  color: #999;
  margin: 20rpx 0 16rpx;
}

/* 筛选选项行 */
.filter-options-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 20rpx;
}

.filter-option, .filter-item {
  min-width: 120rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  border: 1rpx solid #eee;
  border-radius: 30rpx;
  font-size: 30rpx;
  color: #666;
  padding: 0 24rpx;
}

.filter-option.active, .filter-item.active {
  background: #1296db;
  color: #fff;
  border-color: #1296db;
}

/* 底部按钮 */
.filter-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eee;
}

.btn-reset, .btn-confirm {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.btn-reset {
  background: #f5f5f5;
  color: #666;
}

.btn-confirm {
  background: #1296db;
  color: #fff;
}

.sort-options {
  background: #fff;
  border: 1rpx solid #ddd;
  border-radius: 6rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  position: absolute;
  top: 60px; /* 根据需要调整 */
  right: 0;
  z-index: 100;
}

.sort-item {
  padding: 10rpx 20rpx;
  font-size: 26rpx;
  color: #333;
}

.sort-item.active {
  background: #1296db;
  color: #fff;
}